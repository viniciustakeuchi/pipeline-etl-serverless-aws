# Usado pelo docker compose e por `python -m etl.local` contra um S3 local (moto server).
# Nada aqui é segredo: o S3 local aceita qualquer credencial.
AWS_ACCESS_KEY_ID=teste
AWS_SECRET_ACCESS_KEY=teste
AWS_DEFAULT_REGION=sa-east-1
BUCKET_DADOS=pipeline-etl-local
S3_ENDPOINT_URL=http://localhost:5000
